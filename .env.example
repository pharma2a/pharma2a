# PharmA2A : toutes les variables, aucune valeur. Copier en .env, remplir ce qu'il faut, puis
# charger le fichier avant de lancer l'agent :  set -a; . ./.env; set +a
# Une variable laissée vide vaut une variable absente.
# En brouillon (défaut), seule une porte est obligatoire (PHARMA2A_JETONS ou PHARMA2A_JETON) :
# rien ne part, tout s'écrit dans sorties/.

# --- l'agent ---
PHARMA2A_JETONS=                # le registre des jetons des officines (python -m pharma2a jeton creer --compte …)
PHARMA2A_JETON=                 # ou un jeton seul, pour une seule officine ou pour les essais
PHARMA2A_COMPTE_CLIENT=         # le compte client auquel ce jeton seul se rattache ; vide : tout compte
PHARMA2A_FOURNISSEUR=           # le nom du fournisseur dans la carte
PHARMA2A_URL=                   # l'adresse annoncée dans la carte, ex. https://agent.fournisseur.example
PHARMA2A_HOTE=                  # où écouter (défaut 127.0.0.1)
PHARMA2A_PORT=                  # (défaut 8765)
PHARMA2A_TOUT_PUBLIC=           # 1 : pas de carte étendue annoncée, la carte publique dit déjà tout (défaut 0)
PHARMA2A_SITE=                  # le site du fournisseur, annoncé dans la carte ; vide : l'adresse de l'agent
PHARMA2A_BASE=                  # le fichier SQLite des tâches ; vide = en mémoire
PHARMA2A_FICHE=                 # le fichier JSON de la fiche du fournisseur, servie sans clé
PHARMA2A_FICHE_TARIF_PUBLIC=0   # 1 : la vitrine sans clé montre aussi le tarif catalogue
PHARMA2A_ANNUAIRE=              # plusieurs agents dans un processus : le fichier JSON de l'annuaire

# --- le canal vers le fournisseur ---
PHARMA2A_BROUILLON=             # 1 : rien ne part (défaut) ; 0 : les mails partent
PHARMA2A_SORTIES=               # le dossier des brouillons (défaut sorties)
PHARMA2A_BACKEND=               # mail (défaut) ou un module backends/<nom>.py
PHARMA2A_ERP_SORTIE=            # canal erp_exemple : le dossier où l'agent dépose les documents (défaut erp/sortie)
PHARMA2A_ERP_ENTREE=            # canal erp_exemple : le dossier où l'ERP dépose les accusés (défaut erp/entree)
PHARMA2A_DESTINATAIRE=          # qui reçoit les commandes au fournisseur
PHARMA2A_COPIE=                 # qui est en copie (le délégué, par exemple)
PHARMA2A_EXPEDITEUR=            # l'adresse d'expédition et de réponse de l'agent

# --- l'envoi : un seul chemin suffit, par ordre de priorité ---
PHARMA2A_GMAIL_COMPTE=          # le fichier d'autorisation Gmail (jeton de renouvellement ou compte de service à délégation)
PHARMA2A_BREVO_CLE=             # la clé de l'API Brevo
PHARMA2A_SMTP_HOTE=             # ou le SMTP classique
PHARMA2A_SMTP_PORT=             # (défaut 587)
PHARMA2A_SMTP_UTILISATEUR=
PHARMA2A_SMTP_MOT_DE_PASSE=

# --- la boîte où arrivent les réponses ---
PHARMA2A_IMAP_HOTE=
PHARMA2A_IMAP_PORT=             # (défaut 993)
PHARMA2A_IMAP_UTILISATEUR=
PHARMA2A_IMAP_MOT_DE_PASSE=
PHARMA2A_IMAP_DOSSIER=          # (défaut INBOX)
PHARMA2A_IMAP_AUTHSERV=         # le serveur de réception dont on croit les Authentication-Results, ex. mx.google.com ; sans lui, aucun verdict positif
PHARMA2A_EXIGER_AUTHENTIFICATION=   # 1 : une réponse que la boîte n'a pas authentifiée est écartée (défaut 0) ; suppose IMAP_AUTHSERV
PHARMA2A_RELECTURE_MINUTES=     # la cadence de relecture (défaut 10 ; 0 = à la main)

# --- la transcription des réponses ---
PHARMA2A_MODELE=                # le nom du modèle qui transcrit, par le SDK Anthropic ; obligatoire avec la clé, aucun défaut dans le code
PHARMA2A_MODELE_CLE=            # sa clé ; sans clé, l'accusé est lu dans un fichier préparé (brouillon, tests)

# --- le mail ---
PHARMA2A_LOGO_PIED=             # l'adresse d'une image pour le pied du mail (facultatif)
